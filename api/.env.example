# API del Club Dermalysse — SOLO PLACEHOLDERS. No pongas valores reales aquí ni en Git.
# Copia a .env (ignorado por Git) o define las variables en el panel del servidor (Railway).

# Puerto del servidor (default 8787; Railway lo inyecta)
PORT=8787

# Modos (van juntos):
#   desarrollo  → AUTH_MODE=dev      + DATA_MODE=memoria   (predeterminado: usuario dev, datos en memoria/fixtures)
#   producción  → AUTH_MODE=firebase + DATA_MODE=firestore (proyecto club-dermalysse + webhook actual)
AUTH_MODE=dev
DATA_MODE=memoria

# Orígenes permitidos por CORS, separados por coma. Obligatorio en producción (dominios del club nuevo).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Solo desarrollo: muestra borradores de la Academia a todos. En producción se rechaza.
ACADEMIA_MOSTRAR_BORRADORES=false

# ───────────────────────────── Producción (AUTH_MODE=firebase + DATA_MODE=firestore) ─────────────────────────────
# JSON COMPLETO de la cuenta de servicio del proyecto club-dermalysse, en una sola línea (puede ser la misma
# que usa el webhook). Secreto: solo en el panel del servidor.
FIREBASE_SERVICE_ACCOUNT=
# URL base del webhook actual (dermalysse-webhook en Railway), https, sin ruta de endpoint.
LEGACY_WEBHOOK_URL=https://webhook.example.invalid
# Opcional: tiempo máximo por llamada al webhook en ms (1000–60000; default 15000).
LEGACY_WEBHOOK_TIMEOUT_MS=
# URL pública del club nuevo (https). Se usa para volver de Stripe: <APP_URL>/#/suscripcion?pago=exito&session_id={CHECKOUT_SESSION_ID}
APP_URL=https://club.example.invalid
# Código oficial de la campaña inicial. Secreto operativo: solo en Railway, nunca en Git ni en el frontend.
CAMPANA_BIENVENIDA_CODIGO=

# ───────────────────────────── Rate limiting (opcional, opt-in) ─────────────────────────────
# Si RATE_LIMIT_MAX está vacío, el limitador queda APAGADO y la API se comporta igual que antes.
# Valores recomendados en producción (Railway) — una instancia, ventana fija por IP:
#   RATE_LIMIT_MAX=240            # peticiones por ventana e IP (global)
#   RATE_LIMIT_WINDOW_MS=60000    # ventana en ms (1000–3600000; default 60000)
#   RATE_LIMIT_SENSITIVE_MAX=20   # límite más estricto para /cupones y /stripe (default = ceil(MAX/10))
#   TRUST_PROXY=1                 # saltos de proxy de confianza para leer la IP real (Railway = 1)
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_SENSITIVE_MAX=
TRUST_PROXY=
