# API del Club Dermalysse — SOLO PLACEHOLDERS. No pongas valores reales aquí ni en Git.
# Copia a .env (ignorado por Git) y rellena en el entorno del servidor.

# Puerto del servidor local (default 8787)
PORT=8787

# Modo de autenticación: "dev" (por defecto, usuario de desarrollo) o "firebase" (requiere service account; no implementado en este slice)
AUTH_MODE=dev

# Orígenes permitidos por CORS en desarrollo, separados por coma. Los dominios de producción se deciden después.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ───────────────────────────────────────────────────────────────────────────
# Seams de integración real (NO implementados en este slice). Nunca valores reales en Git.
# Firebase Admin (verificación de ID token): ruta/JSON del service account vía entorno del servidor.
FIREBASE_SERVICE_ACCOUNT=
# Stripe (pagos): clave secreta y secreto de webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Bunny Stream (video protegido): claves de firma de embed.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=
