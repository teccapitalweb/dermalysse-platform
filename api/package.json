{
  "name": "dermalysse-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "API del Club Dermalysse. Desarrollo: auth dev + memoria/fixtures. Producción: Firebase Auth + Firestore (club-dermalysse) y el webhook actual para Bunny, Stripe, avance y certificados.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "express": "4.21.2",
    "firebase-admin": "14.5.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.6",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
