# Cliente Vite (club y landing). Copia a `.env.local` solo para pruebas locales; nunca subas `.env*`.
#
# Sin VITE_API_URL la app arranca en MODO DEMO (datos locales, sin login real ni cobros).
# Con VITE_API_URL arranca en MODO API: login Firebase real, membresía, avance de video,
# certificados y Stripe pasan por la API (ver docs/INTEGRACION-PRODUCCION.md, sección 3).
VITE_API_URL=

# Configuración WEB de Firebase del proyecto `club-dermalysse` (pública por diseño: es la misma
# que publica hoy el club actual). Si se dejan vacías se usan esos valores públicos de
# src/core/firebase-config.ts. Aquí nunca van cuentas de servicio ni llaves privadas.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL pública (https) del panel admin ACTUAL (repo teccapitalweb/admin_club_dermalysse). En modo API el
# admin nuevo solo tiene «Academia»; con esta variable el admin muestra una tarjeta «Abrir panel admin
# actual» para miembros, cursos, cupones, comunidad, avisos y ajustes. Vacía ⇒ la tarjeta no se muestra.
# Confirma la URL real antes de usarla (el repo no publica hosting en firebase.json; los correos del
# webhook enlazan a una página de GitHub Pages que hay que verificar).
VITE_ADMIN_LEGADO_URL=
